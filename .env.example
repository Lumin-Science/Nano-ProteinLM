# speedrun.sh loads .env automatically. All paths may be absolute or relative
# to the repository root. Copy this file to .env and edit only what you need.

# Keep the uv environment, downloads, prepared mmap data, and runs together.
ARTIFACT_ROOT="${ARTIFACT_ROOT:-.exps}"

# The verified public release used by the repository.
DATA_REPO_ID="${DATA_REPO_ID:-LuminScience/LuminBench-Nano-ESMC}"
DATA_REVISION="${DATA_REVISION:-bd38448d50d8f426d7b9bd4410b53159ea001259}"

# Original ESMC-300M four-GPU, four-hour setting.
CONFIG="${CONFIG:-configs/esmc-300m-original.yaml}"
TRAINING_SAMPLES="${TRAINING_SAMPLES:-5376000}"
NUM_GPUS="${NUM_GPUS:-4}"
WALLTIME_SECONDS="${WALLTIME_SECONDS:-14400}"
DOWNLOAD_WORKERS="${DOWNLOAD_WORKERS:-8}"
RUN_NAME="${RUN_NAME:-esmc-300m-original}"

# Opt-in one-hour retained AutoResearch incumbent:
# CONFIG=configs/autoresearch_300m_4xa100_1h.yaml
# WALLTIME_SECONDS=3600
# RUN_NAME=autoresearch-incumbent-1h

# Optional path overrides:
# DATA_CACHE_ROOT=/path/to/huggingface-dataset-cache
# DATA_ROOT=/path/to/prepared-mmap-data
# OUTPUT_ROOT=/path/to/run-output
# UV_CACHE_DIR=/path/to/uv-cache
# UV_PROJECT_ENVIRONMENT=/path/to/venv
# HF_HOME=/path/to/huggingface-client-cache

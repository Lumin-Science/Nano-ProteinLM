{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoResearch task contract v1",
  "description": "A task specification, not an executable training config or security sandbox.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "contract_status": {
          "enum": [
            "defined",
            "example"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "repository",
        "source_commit",
        "contract_status"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "established": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "baseline",
        "capabilities",
        "limitations"
      ]
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "score": {
          "$ref": "#/$defs/metric"
        },
        "repeats": {
          "$ref": "#/$defs/repeats"
        },
        "budget": {
          "$ref": "#/$defs/budget"
        },
        "hardware": {
          "$ref": "#/$defs/hardware"
        },
        "evaluation": {
          "$ref": "#/$defs/evaluation"
        },
        "validity_gates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "promotion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "rule": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "reference",
            "rule"
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "score",
        "repeats",
        "budget",
        "hardware",
        "evaluation",
        "validity_gates",
        "promotion",
        "diagnostics"
      ]
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_policy": {
          "const": "protected"
        },
        "protected_paths_take_precedence": {
          "const": true
        },
        "editable_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "protected_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "artifact_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "editable_config_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "frozen_config_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "default_policy",
        "protected_paths_take_precedence",
        "editable_paths",
        "protected_paths",
        "artifact_paths",
        "editable_config_keys",
        "frozen_config_keys",
        "rules"
      ]
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "budget": {
          "$ref": "#/$defs/budget"
        },
        "hardware": {
          "$ref": "#/$defs/hardware"
        },
        "repeats": {
          "$ref": "#/$defs/repeats"
        },
        "evaluation": {
          "$ref": "#/$defs/evaluation"
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metric"
          },
          "minItems": 1
        },
        "success_rule": {
          "type": "string",
          "minLength": 1
        },
        "comparison_references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "selection_policy": {
          "type": "string",
          "minLength": 1
        },
        "evaluation_overlap": {
          "type": "string",
          "minLength": 1
        },
        "transfer": {
          "type": "object",
          "description": "Task-specific settings; freeze the resolved values before a campaign."
        },
        "validity_gates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "budget",
        "hardware",
        "repeats",
        "evaluation",
        "metrics",
        "success_rule",
        "comparison_references",
        "selection_policy",
        "evaluation_overlap",
        "transfer",
        "validity_gates"
      ]
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "research_status": {
          "enum": [
            "existing_runner",
            "adapter_required"
          ]
        },
        "test_status": {
          "enum": [
            "existing_runner",
            "adapter_required"
          ]
        },
        "boundary_status": {
          "type": "string",
          "minLength": 1
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "research_status",
        "test_status",
        "boundary_status",
        "gaps"
      ]
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "task",
    "question",
    "established",
    "research",
    "boundaries",
    "test",
    "implementation",
    "provenance"
  ],
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "aggregation": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "minimize",
            "maximize"
          ]
        }
      },
      "required": [
        "name",
        "unit",
        "definition",
        "artifact",
        "aggregation",
        "direction"
      ]
    },
    "repeats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": {
          "type": "string",
          "minLength": 1,
          "description": "Name the independent experimental unit; for example training_seed or paired_process_timing."
        },
        "count": {
          "type": "integer",
          "minimum": 2
        },
        "identities": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "string"
            ]
          },
          "uniqueItems": true,
          "minItems": 2
        },
        "matching": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "unit",
        "count",
        "identities",
        "matching",
        "uncertainty"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "unit": {
                "const": "paired_process_timing"
              }
            }
          },
          "then": {
            "properties": {
              "count": {
                "minimum": 5
              },
              "identities": {
                "minItems": 5
              }
            }
          }
        }
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "wall_time",
            "tokens",
            "fixed_work"
          ]
        },
        "amount": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "meter": {
          "type": "string",
          "minLength": 1
        },
        "completion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "amount",
        "unit",
        "meter",
        "completion"
      ]
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "resources": {
          "type": "object",
          "minProperties": 1
        }
      },
      "required": [
        "description",
        "resources"
      ]
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "settings": {
          "type": "object",
          "description": "Task-specific settings; freeze the resolved values before a campaign."
        }
      },
      "required": [
        "entrypoint",
        "settings"
      ]
    }
  }
}
